<?xml version="1.0" encoding="utf-8"?>
<!--
    The app owns its own recovery path: LearningRepository writes a full-state
    JSON backup (BackupManager) and restores from it on a fresh install. Exclude
    every app-private state source so a partial raw restore cannot compete with
    that explicit, validated recovery path.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
